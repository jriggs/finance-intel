{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/main.js --target=es2020 --format=iife",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/main.js --target=es2020 --format=iife --watch=forever --serve=localhost:3000 --servedir=. --serve-fallback=index.html",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "marked": "^18.0.2"
  }
}
