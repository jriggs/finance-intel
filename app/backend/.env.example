# ══════════════════════════════════════════════════════════════════════════════
# Local LLM Chat + Finance Intelligence — Environment Config
# Copy to .env and fill in your values. Only MODEL_PATH is strictly required.
# ══════════════════════════════════════════════════════════════════════════════


# ── LLM Model ─────────────────────────────────────────────────────────────────
# Path to your downloaded GGUF model file (relative to backend/ or absolute)
# Recommended: https://huggingface.co/models?search=gguf
#   ../models/qwen2.5-14b.gguf   (best quality, 32GB)
#   ../models/llama-3.1-8b.gguf  (great, 16GB)
#   ../models/mistral-7b.gguf    (balanced, 16GB)
#   ../models/phi-3-mini.gguf    (fastest, 8GB)
MODEL_PATH=../models/your-model.gguf

# Optional: dedicated vision model (auto-detected from models/ if omitted)
# VISION_MODEL_PATH=../models/your-vision-model.gguf


# ── Inference ─────────────────────────────────────────────────────────────────
N_CTX=4096          # context window tokens (4096–8192 on 16GB M1 Pro)
N_GPU_LAYERS=-1     # Metal layers (-1 = all, 0 = CPU only)
N_THREADS=8         # CPU threads (M1 Pro = 8 performance cores)
TOP_P=0.95
TOP_K=40
REPEAT_PENALTY=1.1


# ── Database ───────────────────────────────────────────────────────────────────
# Absolute or relative (to backend/) path for the SQLite database
FINANCE_DB_PATH=../data/finance.db

# ── RAG / Vector Store ────────────────────────────────────────────────────────
DATA_DIR=./data
# Embedding model — auto-downloaded on first run
#   nomic-ai/nomic-embed-text-v1.5  (137MB, recommended)
#   all-MiniLM-L6-v2                (22MB, fastest)
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64


# ── System Prompt ─────────────────────────────────────────────────────────────
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant with full internet access. Be concise and direct."


# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for fine-tuning. Get token: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here


# ══════════════════════════════════════════════════════════════════════════════
# Finance Intelligence  →  http://localhost:8000/finance
# ══════════════════════════════════════════════════════════════════════════════


# ── Alpaca Broker ─────────────────────────────────────────────────────────────
# Free account + paper trading: https://alpaca.markets
# Paper dashboard: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true       # set false only when ready for real money


# ── FRED (Federal Reserve Economic Data) ─────────────────────────────────────
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Provides GDP, CPI, Fed Funds Rate, unemployment, yield curve, VIX, M2, etc.
FRED_API_KEY=your_fred_api_key


# ── OpenFIGI ─────────────────────────────────────────────────────────────────
# Optional — free key raises rate limits: https://www.openfigi.com/api
OPENFIGI_API_KEY=


# ── Crawler ───────────────────────────────────────────────────────────────────
# Background web crawler interval (minutes)
CRAWL_INTERVAL_MIN=60
